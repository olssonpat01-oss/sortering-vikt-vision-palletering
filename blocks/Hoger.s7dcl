{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "Hoger"
    VAR
        Steg : Int;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
           // Vänster och höger linjes band går i drift. Lätta kartonger räknas när de passerar Diffuse Sensor 3.
           "Belt Conveyor (4m) 0" := "Drift_DB".Steg = 3 OR "Drift_DB".Steg = 4;
           "Belt Conveyor (4m) 1" := "Belt Conveyor (4m) 0";
           "Belt Conveyor (4m) 4" := "Belt Conveyor (4m) 0";
           "Belt Conveyor (4m) 5" := "Belt Conveyor (4m) 0";
        
           CASE #Steg OF
               0:  // Väntar på kartong
                   // Klart när: Diffuse Sensor 3 ser den
                   IF "Diffuse Sensor 3" THEN
                       #Steg := 1;
                   END_IF;
        
               1:  // Kartongen passerar
                   // Klart när: givaren fri -> räkna
                   IF NOT "Diffuse Sensor 3" THEN
                       "Sort_DB".Antal_Hoger := "Sort_DB".Antal_Hoger + 1;
                       #Steg := 0;
                   END_IF;
           END_CASE;
    END_NETWORK
END_FUNCTION_BLOCK
